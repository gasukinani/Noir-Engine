scene LoftArena {
    renderer = noir_gfx
    environment = procedural_pbr
    sky = noir_deep_gradient
    exposure = 1.10
    fog_density = 0.010
    render_scale = 1.0
    shadows = pcf_soft
    color_space = srgb
    tone_mapping = aces

    node WorldEnvironment {
        type = WORLD_ENVIRONMENT
        sky = procedural
        clouds = procedural
        fog = volumetric
        exposure = 1.10
    }

    node MainLight {
        type = LIGHT3D
        position = (0, 12, 6)
        rotation = (-42, -28, 0)
        color = (1.0, 0.86, 0.68)
        intensity = 3.2
        shadows = true
        shadow_quality = high
    }

    node ProceduralTerrain {
        type = TERRAIN3D
        size = (44, 4, 44)
        resolution = 48
        material = materials/terrain_pbr.game
        collision = true
    }

    node CentralPlatform {
        type = MESH3D
        position = (0, 1.15, 0)
        scale = (1.7, 1.15, 1.7)
        primitive = box
        material = materials/metal_pbr.game
    }

    node Player {
        type = CHARACTER3D
        position = (0, 2.2, 8)
        script = scripts/player.game
        speed = 5.0
        jump = 4.5
        node Camera3D {
            type = CAMERA3D
            fov = 64
            near = 0.05
            far = 180
            current = true
        }
    }

    node DirectionalSun {
        type = LIGHT3D
        rotation = (-52, 24, 0)
        color = (1.0, 0.80, 0.58)
        intensity = 1.4
        shadows = true
    }

    node ReflectionProbe {
        type = REFLECTION_PROBE3D
        size = (24, 8, 24)
        intensity = 0.65
    }

    node WorldGrid {
        type = GRID3D
        size = (44, 44)
        spacing = 1.0
        editor_only = true
    }
}
